---
import _get from "lodash/get";
import Header from "@components/mobile/header/Header.astro";
import Article from "@components/mobile/article/Article.astro";
import TrendingStock from "@components/mobile/trendingStock/TrendingStock.astro";
import Footer from "@components/mobile/footer/Footer.astro";
import BottomSticky from "@components/mobile/bottomSticky/BottomSticky.astro";
const { pageTarget, app } = Astro.props;
const ads = _get(app, "response.ads", {});
---

<Fragment>
  <Header />
  <TrendingStock />
  <Article app={app} category={pageTarget.category} msid={pageTarget.msid} pageTarget={pageTarget} />
  <slot />
  <Footer />
  <BottomSticky stickyAds={ads?.stky} pageTarget ={pageTarget} />
</Fragment>
