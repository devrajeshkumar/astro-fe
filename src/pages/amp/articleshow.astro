---
import AMPLayout from "../../layouts/amp/Layout.astro";

const values = Astro.url.searchParams;
const msid = values.get("id");
const articleData = await fetch(
    `https://apihindi.etnownews.com/request/articleshow?origin=amp&msid=${msid}&channel_id=386`,
);
const app = await articleData.json();
---

<!doctype html>
<html ⚡ lang="en">
    <AMPLayout
        app={app}
    />
</html>
