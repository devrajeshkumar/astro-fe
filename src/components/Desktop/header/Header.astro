---
import style from "./Header.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import TopNavigation from "../topNavigation/TopNavigation.astro";
import Navigation from "../navigation/Navigation.astro";
import LazyImage from "@components/common/lazyImage/LazyImage.astro";
import Link from "@components/common/link/Link.astro";

const navData = await fetch("https://apihindi.etnownews.com/api/getnavigation?msid=ALL&channel_id=386");
const navDataJson = await navData.json();
const { pageTarget } = Astro.props;
---

<header class={`${style['header']}`}>
  <div class={`${style["header-top-nav"]}`}>
    <ContainerBox>
      <TopNavigation navLinks={navDataJson?.networks}/>
    </ContainerBox>
  </div>
  <ContainerBox>
    <div class={`${style['header-logo']}`}>
        <Link link={"/"} className={`${style['header-logo']}`}>
            <LazyImage datasrc={'/assets/images/ET-Now-desktop-logo.svg'} alt={'ET Now Swadesh'} />
        </Link>
    </div>
  </ContainerBox>
  <div class={`${style["header-main-nav"]}`}>
    <ContainerBox>
      <Navigation navLinks={navDataJson?.response} pageTarget = {pageTarget} />
    </ContainerBox>
  </div>
</header>