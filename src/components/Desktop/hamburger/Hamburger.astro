---
import { NAVIGATION_GROUPS } from "@utils/common";
import style from "./Hamburger.module.scss";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import Link from "@components/common/link/Link.astro";

// Menu data structure
const menuData = NAVIGATION_GROUPS;
const { data } = Astro.props;
function groupMenuData(flatData) {
      const findByTitle = (title) => flatData?.find(item => item?.title === title);
    
      return NAVIGATION_GROUPS?.map(group => ({
        section: group?.section,
        icon: group?.icon,
        items: group?.titles
          ?.map(title => findByTitle(title))
          ?.filter(Boolean) // Remove undefined if title not found
          ?.map(item => {
            if (item?.child) {
              return { ...item, child: item?.child?.map(child => ({ ...child })) };
            }
            return item;
          }),
      }));
    }

    const groupedDataNavigation = groupMenuData(data); 
---

<nav class={style.navigation} id="hamburgerMenu">
  <ul class={style.mainMenu}>
    {groupedDataNavigation?.map((category) => (
      <li class={style.categoryItem}>
        <div class={style.categoryHeader}>
          <span class={style.categoryIcon} aria-hidden="true">
            <SvgIcon IconName={category.icon} width="17" height="17" />
          </span>
          <h3 class={style.categoryTitle}>{category.section}</h3>
        </div>
        <ul class={style.subMenu}>
          {category.items.map((item) => (
            <li class={style.subMenuItem}>
              <Link link={item.seopath} className={style.subMenuLink}>
                {item.title}
              </Link>
              {
                item?.child?.length > 0 && (
                  <ul class={style.subMenu}>
                    {item?.child?.map((child) => (
                      <li class={style.subMenuItem}>
                        <Link link={child.seopath} className={style.subMenuLink}>
                          {child.title}
                        </Link>
                      </li>
                    ))}
                  </ul>
                )
              }
            </li>
          ))}
        </ul>
      </li>
    ))}
  </ul>

</nav>