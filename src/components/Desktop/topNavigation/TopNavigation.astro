---
import style from "./TopNavigation.module.scss";
import Typography from "@components/common/widgets/typography/Typography.astro";
import DotsMenuIcon from "@components/common/widgets/dotsMenuIcon/DotsMenuIcon.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import MegaDropDownBox from "@components/common/wrappers/megaDropDownBox/MegaDropDownBox.astro";
import Search from "@components/common/search/Search.astro";

const { changeStyle = "", inLineStyle = {}, navLinks = [] } = Astro.props;

let combinedNavLinks = [
  {
    href: "https://www.etnownews.com/",
    title: "ET Now",
    isActive: true,
  },
  ...navLinks,
];
---

<div id="navDisabled" class={`${style["nav-wrap"]}`} data-nav-disabled-class={style.navDisabled}>
  <div class={`${style["position-relative"]}`} id="topNavigationContainer">
    <ul
      class={`${style["nav-ul"]} ${changeStyle ? style[changeStyle] : ""}`}
      style={inLineStyle}
      id="topNavigation"
    >
      {
        combinedNavLinks.map(
          ({
            href,
            title,
            isActive = false,
          }: {
            href: string;
            title: string;
            isActive: boolean;
          }) => (
            <li class={`${style['disable']}`}>
              <a
                href={href}
                title={title}
                class={`${style["nav-link"]} ${isActive ? style["nav-active"] : ""}`}
              >
                <Typography
                  tag="span"
                  text={title}
                  changeStyle="font-size-12"
                  fontWeight="400"
                  isLineClamp={false}
                  inLineStyle={{
                    lineHeight: "1.2",
                    letterSpacing: ".1em",
                    whiteSpace: "nowrap",
                  }}
                />
              </a>
            </li>
          ),
        )
      }
      <li
        id="topNavigationMoreButton"
        class={`${style["more-link-button"]} ${style['disable']}`}
        style={{ display: "none" }}
      >
        <DotsMenuIcon />
        <SvgIcon
          size="sm"
          IconName="CloseIconBigWhite"
          width="12"
          height="12"
        />

        <MegaDropDownBox
          id="topNavigationMoreMenu"
          inLineStyle={{
            display: "none",
            width: "auto",
            padding: "0",
            minHeight: "50px",
            left: "inherit",
            maxWidth: "fit-content",
          }}
        >
          <ul
            class={`${style["more-menu-list"]}`}
            id="topNavigationMoreMenuList"
          >
          </ul>
        </MegaDropDownBox>
      </li>
    </ul>
  </div>
  <div class={`${style["nav-rhs"]}`}>
    <ul class={`${style["nav-ul"]}`}>
      <li class={style['disable']}>
        <a href="#" title={""} class={`${style["nav-link"]}`}>
          <SvgIcon
            size="sm"
            IconName="LanguageSwaitchIcon"
            width="27"
            height="27"
          />
        </a>
      </li>
      <li class={style['disable']}>
        <a
          href="#"
          title="Live Tv"
          class={`${style["nav-link"]} ${style["nav-live-tv"]}`}
        >
          <SvgIcon size="sm" IconName="livetvNewIcon" width="17" height="15" />
          <Typography
            tag="span"
            text={"Live Tv"}
            changeStyle="font-size-12"
            fontWeight="700"
            isLineClamp={false}
            inLineStyle={{
              lineHeight: "1.2",
              whiteSpace: "nowrap",
              textTransform: "uppercase",
            }}
          />
        </a>
      </li>
      <li class={style['disable']}>
        <button class={`${style["nav-link"]} ${style["nav-user"]}`}>
          <SvgIcon size="sm" IconName="userIconWhite" width="27" height="27" />
        </button>
      </li>
      <li>
        <button class={`${style["nav-link"]}`} id="searchToggleBtn">
          <SvgIcon
            id="searchIcon"
            size="sm"
            IconName="searchNewIconDesktopWhite"
            width="27"
            height="27"
          />
          <SvgIcon
            id="closeIcon"
            size="sm"
            IconName="CloseIconBigWhite"
            width="27"
            height="18"
            inLineStyle={{ display: "none" }}
          />
        </button>
      </li>
    </ul>
  </div>

  <MegaDropDownBox id="searchDropdown" inLineStyle={{ display: "none", minHeight: 'auto' }}>
    <Search isTopNavigation = {true} instanceId="topNav" client:load/>
  </MegaDropDownBox>
</div>

<script define:vars={{ navLinks }}>
  document.addEventListener("DOMContentLoaded", function () {
    const topNavigation = document.getElementById("topNavigationContainer");
    const moreButton = document.getElementById("topNavigationMoreButton");
    const moreMenu = document.getElementById("topNavigationMoreMenu");
    const moreMenuList = document.getElementById("topNavigationMoreMenuList");
    const navItems = topNavigation.querySelectorAll("li");

    function handleOverflow() {
      // Reset
      moreMenuList.innerHTML = "";
      moreMenu.style.display = "none";
      moreButton.style.display = "none";
      navItems.forEach((item) => (item.style.display = ""));

      let totalWidth = topNavigation.offsetWidth;
      let usedWidth = 0;
      let overflowLinks = [];

      for (let i = 0; i < navItems.length; i++) {
        usedWidth += navItems[i].offsetWidth;
        if (usedWidth > totalWidth) {
          overflowLinks.push(navLinks[i - 2]);
          navItems[i].style.display = "none";
        }
      }

      if (overflowLinks.length > 0) {
        moreButton.style.display = "block";
        // moreMenu.style.display = 'block';
        overflowLinks.forEach((link) => {
          const li = document.createElement("li");
          const a = document.createElement("a");
          const typographySpan = document.createElement("span");
          a.href = link?.href;
          a.title = link?.title;
          a.target = "_blank";
          a.classList.add("nav-link");
          typographySpan.textContent = link?.title;
          typographySpan.style.cssText = `
            font-size: 12px;
            font-weight: 400;
            line-height: 1.2;
            letter-spacing: .1em;
            white-space: nowrap;
          `;
          a.appendChild(typographySpan);
          li.appendChild(a);
          moreMenuList.appendChild(li);
        });
      }

      // Delete the nav items which are display none
      navItems.forEach((item, index) => {
        if (item.style.display === "none") {
          navItems[index].remove();
        }
      });
    }

    handleOverflow();
    window.addEventListener("resize", handleOverflow);

    // Toggle more menu visibility

    // moreButton.addEventListener("click", () => {
    //   moreMenu.style.display =
    //     moreMenu.style.display === "block" ? "none" : "block";
    // });

    moreButton.addEventListener("mouseover", () => {
      moreMenu.style.display = "block";
    });

    moreButton.addEventListener("mouseout", () => {
      moreMenu.style.display = "none";
    });
  });
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const searchToggleBtn = document.getElementById("searchToggleBtn");
    const searchDropdown = document.getElementById("searchDropdown");
    const searchIcon = document.getElementById("searchIcon");
    const closeIcon = document.getElementById("closeIcon");
    const navDisabled = document.getElementById("navDisabled");

    if (
      !searchToggleBtn ||
      !searchDropdown ||
      !searchIcon ||
      !closeIcon ||
      !navDisabled
    )
      return;

    const navDisabledClass = navDisabled.dataset.navDisabledClass;

    let isSearchOpen = false;

    function toggleSearchDropdown() {
      isSearchOpen = !isSearchOpen;

      searchDropdown.style.display = isSearchOpen ? "block" : "none";
      searchIcon.style.display = isSearchOpen ? "none" : "inline-block";
      closeIcon.style.display = isSearchOpen ? "inline-block" : "none";

      if (isSearchOpen) {
        navDisabled.classList.add(navDisabledClass);
      } else {
        navDisabled.classList.remove(navDisabledClass);
      }
    }

    searchToggleBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      toggleSearchDropdown();
    });

    document.addEventListener("click", (event) => {
      if (
        isSearchOpen &&
        !searchDropdown.contains(event.target) &&
        !searchToggleBtn.contains(event.target)
      ) {
        isSearchOpen = false;
        searchDropdown.style.display = "none";
        searchIcon.style.display = "inline-block";
        closeIcon.style.display = "none";
        navDisabled.classList.remove(navDisabledClass);
      }
    });
  });
</script>
