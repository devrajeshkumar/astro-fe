---
import style from "./Footer.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import CONST from "@constant/index";

const response = await fetch(
  `https://apihindi.etnownews.com/request/footer?channel_id=386`,
);

const data = await response.json();

const aboutText = data?.response?.[0]?.title;
const readMore = data?.response?.[0]?.description;
const assetMngComp = data?.response?.[0]?.data?.browseAssetManagementCompanies;
const footerMenu = data?.response?.[0]?.data?.footerlinks;
const footerBrandMenu = data?.response?.[0]?.data?.footerBrandlinks;
const footerLatestMenu = data?.response?.[0]?.data?.latestNews;
const footerCompanyMenu = data?.response?.[0]?.data;
---

<footer class={`${style["footer"]}`}>
  <ContainerBox>
    <Typography
      tag="h2"
      text={aboutText}
      changeStyle="font-size-16"
      fontWeight="700"
      isLineClamp={false}
      isWhiteLayout={true}
      inLineStyle={{
        marginBottom: "10px",
      }}
    />
    <div class={`${style["footer-description"]}`}>
      <Typography
        tag="p"
        text={`${readMore}`}
        changeStyle="font-size-14"
        fontWeight="400"
        isLineClamp={false}
        isWhiteLayout={true}
        inLineStyle={{
          lineHeight: "1.83",
          color: "hsla(0,0%,100%,.75)",
          marginBottom: "15px",
        }}
      />
    </div>

    <ul class={`${style["footer-social"]}`}>
      <li>
        <Typography
          tag="p"
          text={"Follow Us :"}
          changeStyle="font-size-16"
          fontWeight="700"
          isLineClamp={false}
          isWhiteLayout={true}
          inLineStyle={{
            lineHeight: "24px",
          }}
        />
      </li>
      <li>
        <a href="#">
          <SvgIcon IconName={"footerFbIcon"} width="22" height="22" />
        </a>
      </li>
      <li>
        <a href="#">
          <SvgIcon IconName={"footerXIcon"} width="22" height="22" />
        </a>
      </li>
      <li>
        <a href="#">
          <SvgIcon IconName={"footerInstaIcon"} width="22" height="22" />
        </a>
      </li>
    </ul>

    <ul class={`${style["footer-stocks"]}`}>
      <li>
        <a href="#">
          <Typography
            tag="p"
            text={`Browse Companies :-`}
            changeStyle={"font-size-16"}
            fontWeight="700"
            isLineClamp={false}
            isWhiteLayout={true}
            inLineStyle={{
              lineHeight: "1",
            }}
          />
        </a>
      </li>
      {
        CONST["STOCK_LINKS"].map(({ link, value }, index) => (
          <li>
            <a href={link}>
              <Typography
                tag="p"
                text={`${value}`}
                changeStyle={"font-size-12"}
                fontWeight="400"
                isLineClamp={false}
                isWhiteLayout={true}
                inLineStyle={{
                  lineHeight: "1",
                }}
              />
            </a>
          </li>
        ))
      }
    </ul>

    <ul class={`${style["footer-stocks"]}`}>
      <li>
        <a href={`http://localhost:3000${assetMngComp?.seopath}`}>
          <Typography
            tag="p"
            text={`${assetMngComp?.title} :-`}
            changeStyle={"font-size-16"}
            fontWeight="700"
            isLineClamp={false}
            isWhiteLayout={true}
            inLineStyle={{
              lineHeight: "1",
            }}
          />
        </a>
      </li>
      {
        assetMngComp?.children?.map(
          ({
            title,
            overridelink,
          }: {
            title: string;
            overridelink: string;
          }) => (
            <li>
              <a href={overridelink}>
                <Typography
                  tag="p"
                  text={`${title}`}
                  changeStyle={"font-size-12"}
                  fontWeight="400"
                  isLineClamp={false}
                  isWhiteLayout={true}
                  inLineStyle={{
                    lineHeight: "1",
                  }}
                />
              </a>
            </li>
          ),
        )
      }
    </ul>

    <div class={style["footer-menu"]}>
      {
        footerMenu.map((section, sectionIndex) => {
          const title = section?.title;
          const links = section?.children;
          return (
            <div id={`${sectionIndex} ${title}`}>
              <Typography
                tag="h4"
                text={title}
                changeStyle="font-size-16"
                fontWeight="700"
                isLineClamp={false}
                isWhiteLayout={true}
                inLineStyle={{
                  lineHeight: "1",
                  marginBottom: "16px",
                }}
              />
              <ul class={style["footer-menu-list"]}>
                {links?.map((item, index) => (
                  <li id={`${index}-footer-menu-list`}>
                    <a href={item.url}>
                      <SvgIcon
                        IconName={"rightArrowIconGrey"}
                        width="6"
                        height="10"
                      />
                      <Typography
                        tag="p"
                        text={item.title}
                        changeStyle="font-size-12"
                        fontWeight="400"
                        isLineClamp={false}
                        isWhiteLayout={true}
                        inLineStyle={{
                          lineHeight: "1",
                          color: "hsla(0,0%,100%,.75)",
                        }}
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>

    <div class={style["footer-menu"]}>
      {
        footerBrandMenu.map((section, sectionIndex) => {
          const title = section?.title;
          const links = section?.children;
          return (
            <div id={`${sectionIndex}-footer-brand-menu`}>
              <Typography
                tag="h4"
                text={title}
                changeStyle="font-size-16"
                fontWeight="700"
                isLineClamp={false}
                isWhiteLayout={true}
                inLineStyle={{
                  lineHeight: "1",
                  marginBottom: "16px",
                }}
              />
              <ul
                class={`${style["footer-menu-list"]} ${style["footer-menu-list-1"]}`}
              >
                {links.map((item, index) => (
                  <li id={`${index}-footer-brand-menu`}>
                    <a href={item.url}>
                      <SvgIcon
                        IconName={"rightArrowIconGrey"}
                        width="6"
                        height="10"
                      />
                      <Typography
                        tag="p"
                        text={item.title}
                        changeStyle="font-size-12"
                        fontWeight="400"
                        isLineClamp={false}
                        isWhiteLayout={true}
                        inLineStyle={{
                          lineHeight: "1",
                          color: "hsla(0,0%,100%,.75)",
                        }}
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </div>

    {
      footerLatestMenu?.length > 0 && (
        <div class={style["footer-menu"]}>
          {
            <div id={`footerLatestMenu`}>
              <Typography
                tag="h4"
                text={"Latest Stories"}
                changeStyle="font-size-16"
                fontWeight="700"
                isLineClamp={false}
                isWhiteLayout={true}
                inLineStyle={{
                  lineHeight: "1",
                  marginBottom: "16px",
                }}
              />
              <ul
                class={`${style["footer-menu-list"]} ${style["footer-menu-list-2"]}`}
              >
                {footerLatestMenu?.children.map((item) => (
                  <li id={`${item?.id}-latest-stories`}>
                    <a href={item?.url}>
                      <Typography
                        tag="p"
                        text={item?.title}
                        changeStyle="font-size-12"
                        fontWeight="400"
                        isLineClamp={false}
                        isWhiteLayout={true}
                        inLineStyle={{
                          lineHeight: "1.56",
                          color: "hsla(0,0%,100%,.75)",
                          display: "inline-block",
                        }}
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          }
        </div>
      )
    }

    <div class={style["footer-menu"]}>
      {
        (
          <div>
            <Typography
              tag="h4"
              text={footerCompanyMenu?.title}
              changeStyle="font-size-16"
              fontWeight="700"
              isLineClamp={false}
              isWhiteLayout={true}
              inLineStyle={{
                lineHeight: "1",
                marginBottom: "16px",
              }}
            />
            <ul
              class={`${style["footer-menu-list"]} ${style["footer-menu-list-1"]}`}
            >
              {footerCompanyMenu?.children.map((item, index) => (
                <li key={index}>
                  <a href={item.url}>
                    <SvgIcon
                      IconName={"rightArrowIconGrey"}
                      width="6"
                      height="10"
                    />
                    <Typography
                      tag="p"
                      text={item.title}
                      changeStyle="font-size-12"
                      fontWeight="400"
                      isLineClamp={false}
                      isWhiteLayout={true}
                      inLineStyle={{
                        lineHeight: "1",
                        color: "hsla(0,0%,100%,.75)",
                      }}
                    />
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }
    </div>
  </ContainerBox>

  <div class={style["footer-copy-right"]}>
    <Typography
      tag={"p"}
      text={`© ${new Date().getFullYear()} Bennett, Coleman & Company Limited`}
      changeStyle={"font-size-14"}
      isLineClamp={false}
      isWhiteLayout={true}
      inLineStyle={{}}
    />
  </div>
</footer>
