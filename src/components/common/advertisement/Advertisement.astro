---
// Advertisement.astro - Updated to use AdManager
export interface Props {
  adCode: string;
  size: (number | number[])[];
  divId: string;
  pageTarget?: {
    section?: {
      category?: string;
      sub_category?: string;
    };
    page?: string;
    metaInfoAttr?: string;
    msid?: string;
    article_index?: string;
    cdp_audience?: string;
    customParams?: Record<string, any>;
    query?: Record<string, any>;
    categoryString?: string;
  };
  queryParams?: {
    utm_source?: string;
    utm_medium?: string;
  };
  className?: string;
  lazyLoad?: boolean;
  spacing?: boolean;
}

const {
  adCode,
  size,
  divId,
  pageTarget = {},
  queryParams = {},
  className = "",
  lazyLoad = false,
  spacing = true,
} = Astro.props;

// Validate required props
if (!adCode || !divId || !size) {
  console.warn("[Advertisement] Missing required props:", { adCode, divId, size });
  return null;
}

// Build data attributes for AdManager
const dataAttributes = {
  "data-adunit": adCode,
  "data-dimensions": JSON.stringify(size),
  "data-lazyload": lazyLoad.toString(),
};

// Add pageTarget data attributes
if (pageTarget?.section?.category) {
  dataAttributes["data-section"] = pageTarget.section.category;
}
if (pageTarget?.section?.sub_category) {
  dataAttributes["data-subsec"] = pageTarget.section.sub_category;
}
if (pageTarget?.page) {
  dataAttributes["data-pagetype"] = pageTarget.page;
}
if (pageTarget?.query && Object.values(pageTarget.query).length > 0) {
  dataAttributes["data-queryid"] = Object.values(pageTarget.query)[0];
}
if (pageTarget?.metaInfoAttr) {
  dataAttributes["data-metainfoattr"] = pageTarget.metaInfoAttr;
}
if (pageTarget?.msid) {
  dataAttributes["data-msid"] = pageTarget.msid;
}
if (pageTarget?.article_index) {
  dataAttributes["data-idx"] = pageTarget.article_index;
}
if (pageTarget?.categoryString) {
  dataAttributes["data-categorystring"] = pageTarget.categoryString;
}

// Add query params
if (queryParams?.utm_source) {
  dataAttributes["data-utm_source"] = queryParams.utm_source;
}
if (queryParams?.utm_medium) {
  dataAttributes["data-utm_medium"] = queryParams.utm_medium;
}

const adClasses = [
  "dfp",
  lazyLoad ? "lazy-ad" : "",
  className,
].filter(Boolean).join(" ");

---

<div
  id={divId}
  class={adClasses}
  {...dataAttributes}
  data-initialized="false"
>
</div>

<script>
  // This script runs for each Advertisement component instance
  document.addEventListener("DOMContentLoaded", () => {
    // Get AdManager instance
    const adManager = window.AdManager?.getInstance();
    if (!adManager) {
      console.error("[Advertisement] AdManager not available");
      return;
    }

    // Find this component's element
    const currentScript = document.currentScript;
    const adElement = currentScript?.previousElementSibling;
    
    if (!adElement || adElement.dataset.initialized === "true") {
      return;
    }

    // Mark as initialized
    adElement.dataset.initialized = "true";

    // Extract ad data and render
    const adData = adManager.getAdData(adElement);
    if (adData) {
      const options = {
        adCode: adData.adCode,
        size: adData.size,
        divId: adData.divId,
        pageTarget: adData.pageTarget,
        queryParams: adData.queryParams
      };

      // Check if should lazy load
      if (adElement.dataset.lazyload === "true" || adElement.classList.contains("lazy-ad")) {
        adManager.setupLazyLoading(adElement, options);
      } else {
        adManager.renderAd(options);
      }
    }
  });
</script>
