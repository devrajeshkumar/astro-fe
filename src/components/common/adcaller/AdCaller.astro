---
import Advertisement from "../advertisement/Advertisement.astro";
export interface Props {
  id?: string;
  isPrimeUser?: boolean;
  isCTN?: boolean;
  position?: number;
  divId?: string;
  adCode?: string;
  size?: (number | number[])[];
  widgetType?: string;
  className?: string;
  theme?: string;
  adKey?: string;
  spacing?: boolean;
  isAndBeyound?: boolean;
  isShortAd?: boolean;
  isGlance?: boolean;
  isInterstitial?: boolean;
  atf?: boolean;
  stickyAd?: boolean;
  pageTarget?: {
    section?: {
      category?: string;
      sub_category?: string;
    };
    page?: string;
    metaInfoAttr?: string;
    msid?: string;
    article_index?: string;
    cdp_audience?: string;
    customParams?: Record<string, any>;
    query?: Record<string, any>;
    categoryString?: string;
  };
  pathname?: string;
  refreshRate?: number;
  isAppView?: boolean;
  changeStyle?: string;
  inlineStyle?: Record<string, any>;
  isSkiplazyload?: boolean;
  isDelay?: boolean;
  parentDivId?: string;
}

const {
  id,
  isPrimeUser = false,
  isCTN = false,
  position,
  divId,
  adCode,
  size,
  widgetType,
  className = "",
  theme = "",
  adKey,
  spacing = true,
  isAndBeyound = false,
  isShortAd = false,
  isGlance = false,
  isInterstitial = false,
  atf,
  stickyAd,
  pageTarget,
  pathname,
  refreshRate,
  isAppView = false,
  changeStyle,
  inlineStyle = {},
  isSkiplazyload = false,
  isDelay = false,
  parentDivId = "",
} = Astro.props;

// Helper functions
function getDFPType(adCode = "") {
  let dfpType;
  const adCodeInCaps = adCode.toUpperCase();
  if (adCodeInCaps) {
    if (adCodeInCaps.indexOf("_ATF") > -1) {
      dfpType = "atf";
    } else if (adCodeInCaps.indexOf("_BTF") > -1) {
      dfpType = "btf";
    } else if (adCodeInCaps.indexOf("_MREC") > -1) {
      dfpType = "mrec";
    } else if (adCodeInCaps.indexOf("_MTF") > -1) {
      dfpType = "mtf";
    } else if (adCodeInCaps.indexOf("_FBN") > -1) {
      dfpType = "fbn";
    } else if (adCodeInCaps.indexOf("GLANCE") > -1) {
      dfpType = "mrec";
    }
  }
  return dfpType;
}

function getMaxHeightFromAdSize(size) {
  if (!size || !Array.isArray(size)) return 0;
  let maxHeight = 0;
  size.forEach((s) => {
    if (Array.isArray(s) && s[1] > maxHeight) {
      maxHeight = s[1];
    } else if (typeof s === "number" && s > maxHeight) {
      maxHeight = s;
    }
  });
  return maxHeight;
}

// Height class mapping
const heightClassMap = {
  50: "ads-50-h",
  90: "ads-90-h",
  100: "ads-100-h",
  125: "ads-125-h",
  200: "ads-200-h",
  250: "ads-250-h",
  300: "ads-280-h",
  280: "ads-280-h",
  600: "ads-600-h",
};

// Validation check
const shouldRender = (isCTN && id) || (!isCTN && divId && adCode);
if (!shouldRender || isPrimeUser) {
  return null;
}

// Build classes
const maxHeight = getMaxHeightFromAdSize(size);
const heightClass = heightClassMap?.[maxHeight] || "";

const adClasses = [
  size ? "ad-div" : "",
  adCode?.indexOf("_PPD_980") > -1 ? "hide_m mb40" : "",
  adCode?.indexOf("_300") !== -1 ? "mrec" : "",
  adCode?.indexOf("_728") > -1 ? "leaderboard" : "",
  className,
  theme === "boxed" ? "boxed" : "",
  theme === "topStrip" ? "top-strip" : "",
  heightClass,
]
  .filter(Boolean)
  .join(" ");

// Build data attributes
const dfpType = getDFPType(adCode);
const dataAttributes: Record<string, any> = {
  "data-type": dfpType,
  "data-adunit": adCode,
  "data-dimensions": JSON.stringify(size),
};

if (pageTarget?.section?.category) {
  dataAttributes["data-section"] = pageTarget.section.category;
}
if (pageTarget?.section?.sub_category) {
  dataAttributes["data-subsec"] = pageTarget.section.sub_category;
}
if (pageTarget?.page) {
  dataAttributes["data-pagetype"] = pageTarget.page;
}
if (pageTarget?.query && Object.values(pageTarget.query).length > 0) {
  dataAttributes["data-QueryId"] = Object.values(pageTarget.query)[0];
}
if (pageTarget?.metaInfoAttr) {
  dataAttributes["data-metaInfoAttr"] = pageTarget.metaInfoAttr;
}
if (pageTarget?.msid) {
  dataAttributes["data-msid"] = pageTarget.msid;
}
if (pageTarget?.article_index) {
  dataAttributes["data-idx"] = pageTarget.article_index;
}
if (refreshRate) {
  dataAttributes["data-refreshRate"] = refreshRate;
}

// Container classes
const containerClasses = [
  isInterstitial
    ? ""
    : isShortAd
      ? "shortvideo-ad bggrayAd"
      : !stickyAd
        ? !atf
          ? isGlance
            ? "bggrayAd bggrayAdGlance"
            : "bggrayAd"
          : "atfAdContainer"
        : "sticky-blocked-container",
  changeStyle || "",
]
  .filter(Boolean)
  .join(" ");

// Container styles
const containerStyle = {
  visibility: isAndBeyound ? "hidden" : "visible",
  position: isAndBeyound ? "absolute" : "",
  ...inlineStyle,
};

// Generate unique ID for lazy loading
const lazyLoadId = `ad-lazy-${divId}-${Date.now()}-${Math.random().toString(36).substr(2, 5)}`;

// CRITICAL: Determine if this ad should be lazy loaded
// Default to lazy loading UNLESS explicitly told not to
const shouldLazyLoad = !atf && !isSkiplazyload && !isGlance;

// Debug info (will be removed in production)
---

{
  !isAppView && (
    <div
      id={parentDivId || `container-${divId}`}
      style={containerStyle}
      class={`ad-container ${containerClasses}`}
      data-lazy-load-id={lazyLoadId}
      data-should-lazy-load={shouldLazyLoad.toString()}
      data-ad-config={JSON.stringify({
        adCode,
        divId,
        size,
        pageTarget,
        pathname,
        isGlance,
        isSkiplazyload,
        isDelay,
        shouldLazyLoad,
        atf,
      })}
    >
      {shouldLazyLoad ? (
        <div
          id={`${divId}-placeholder`}
          class={`ad-placeholder ${adClasses}`}
          style={{
            minHeight: maxHeight ? `${maxHeight}px` : "250px",
          }}
          {...dataAttributes}
          data-original-div-id={divId}
        />
      ) : !isSkiplazyload && !isGlance ? (
        <Advertisement
          adCode={adCode}
          size={size}
          divId={divId}
          pageTarget={pageTarget}
        >
          <div
            id={divId}
            class={`dfp ${adClasses}`}
            style={!spacing ? { padding: "0px" } : { padding: "8px" }}
            {...dataAttributes}
          />
        </Advertisement>
      ) : (
        <div
          id={divId}
          class={`${isSkiplazyload && !isDelay ? "dfp" : ""} ${isDelay ? "dfp-delay" : ""} ${adClasses}`}
          style={!spacing ? { padding: "0px" } : { padding: "8px" }}
          {...dataAttributes}
        />
      )}
    </div>
  )
}

<style>
  .ad-container {
    margin: 0;
    position: relative;
  }
</style>
