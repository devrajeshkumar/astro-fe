---
// AdCaller.astro - Updated to use AdManager
import Advertisement from "../advertisement/Advertisement.astro";
export interface Props {
  id?: string;
  isPrimeUser?: boolean;
  isCTN?: boolean;
  position?: number;
  divId?: string;
  adCode?: string;
  size?: (number | number[])[];
  widgetType?: string;
  className?: string;
  theme?: string;
  adKey?: string;
  spacing?: boolean;
  isAndBeyound?: boolean;
  isShortAd?: boolean;
  isGlance?: boolean;
  isInterstitial?: boolean;
  atf?: boolean;
  stickyAd?: boolean;
  pageTarget?: {
    section?: {
      category?: string;
      sub_category?: string;
    };
    page?: string;
    metaInfoAttr?: string;
    msid?: string;
    article_index?: string;
    cdp_audience?: string;
    customParams?: Record<string, any>;
    query?: Record<string, any>;
    categoryString?: string;
  };
  pathname?: string;
  refreshRate?: number;
  isAppView?: boolean;
  changeStyle?: string;
  inlineStyle?: Record<string, any>;
  isSkiplazyload?: boolean;
  isDelay?: boolean;
  parentDivId?: string;
}

const {
  id,
  isPrimeUser = false,
  isCTN = false,
  position,
  divId,
  adCode,
  size,
  widgetType,
  className = "",
  theme = "",
  adKey,
  spacing = true,
  isAndBeyound = false,
  isShortAd = false,
  isGlance = false,
  isInterstitial = false,
  atf,
  stickyAd,
  pageTarget,
  pathname,
  refreshRate,
  isAppView = false,
  changeStyle,
  inlineStyle = {},
  isSkiplazyload = false,
  isDelay = false,
  parentDivId = "",
} = Astro.props;

// Helper functions

function getMaxHeightFromAdSize(size) {
  if (!size || !Array.isArray(size)) return 0;
  let maxHeight = 0;
  size.forEach((s) => {
    if (Array.isArray(s) && s[1] > maxHeight) {
      maxHeight = s[1];
    } else if (typeof s === "number" && s > maxHeight) {
      maxHeight = s;
    }
  });
  return maxHeight;
}

// Height class mapping
const heightClassMap = {
  50: "ads-50-h",
  90: "ads-90-h",
  100: "ads-100-h",
  125: "ads-125-h",
  200: "ads-200-h",
  250: "ads-250-h",
  300: "ads-280-h",
  280: "ads-280-h",
  600: "ads-600-h",
};

// Validation check
const shouldRender = (isCTN && id) || (!isCTN && divId && adCode);
if (!shouldRender || isPrimeUser) {
  return null;
}

// Build classes
const maxHeight = getMaxHeightFromAdSize(size);
const heightClass = heightClassMap?.[maxHeight] || "";

const adClasses = [
  size ? "ad-div" : "",
  adCode?.indexOf("_PPD_980") > -1 ? "hide_m mb40" : "",
  adCode?.indexOf("_300") !== -1 ? "mrec" : "",
  adCode?.indexOf("_728") > -1 ? "leaderboard" : "",
  className,
  theme === "boxed" ? "boxed" : "",
  theme === "topStrip" ? "top-strip" : "",
  heightClass,
]
  .filter(Boolean)
  .join(" ");

// Container classes
const containerClasses = [
  isInterstitial
    ? ""
    : isShortAd
      ? "shortvideo-ad bggrayAd"
      : !stickyAd
        ? !atf
          ? isGlance
            ? "bggrayAd bggrayAdGlance"
            : "bggrayAd"
          : "atfAdContainer"
        : "sticky-blocked-container",
  changeStyle || "",
]
  .filter(Boolean)
  .join(" ");

// Container styles
const containerStyle = {
  visibility: isAndBeyound ? "hidden" : "visible",
  position: isAndBeyound ? "absolute" : "",
  ...inlineStyle,
};

// Determine loading strategy
const shouldLazyLoad = !atf && !isSkiplazyload && !isGlance;
const shouldDelay = isDelay;

// Build query params
const queryParams = {
  utm_source: pageTarget?.customParams?.utm_source,
  utm_medium: pageTarget?.customParams?.utm_medium,
};
---

{
  !isAppView && (
    <div
      id={parentDivId || `container-${divId}`}
      style={containerStyle}
      class={`ad-container ${containerClasses}`}
      data-ad-type="adcaller"
      data-should-lazy-load={shouldLazyLoad.toString()}
      data-should-delay={shouldDelay.toString()}
      data-atf={atf?.toString()}
    >
      {shouldLazyLoad ? (
        // <div
        //   class={`ad-placeholder ${adClasses}`}
        //   style={{
        //     minHeight: maxHeight ? `${maxHeight}px` : "250px",
        //   }}
        //   data-placeholder-for={divId}
        // />
        <Advertisement
          adCode={adCode}
          size={size}
          divId={divId}
          pageTarget={pageTarget}
          queryParams={queryParams}
          className={adClasses}
          lazyLoad={true}
          spacing={spacing}
        />
      ) : shouldDelay ? (
        <Advertisement
          adCode={adCode}
          size={size}
          divId={divId}
          pageTarget={pageTarget}
          queryParams={queryParams}
          className={`dfp-delay ${adClasses}`}
          spacing={spacing}
        />
      ) : (
        <Advertisement
          adCode={adCode}
          size={size}
          divId={divId}
          pageTarget={pageTarget}
          queryParams={queryParams}
          className={adClasses}
          spacing={spacing}
        />
      )}
    </div>
  )
}

<script>
  // Enhanced AdCaller initialization
  document.addEventListener("DOMContentLoaded", () => {
    initializeAdCaller();
  });

  // Handle Astro navigation
  document.addEventListener("astro:after-swap", () => {
    setTimeout(initializeAdCaller, 100);
  });

  function initializeAdCaller() {
    const adManager = window.AdManager?.getInstance();
    if (!adManager) {
      console.error("[AdCaller] AdManager not available");
      return;
    }

    // Process delayed ads after page load
    window.addEventListener("load", () => {
      setTimeout(() => {
        adManager.discoverAndRenderAds('.dfp-delay');
      }, 7000);
    });

    // Mark AdCaller as initialized
    document.body.dataset.adCallerInitialized = "true";
  }
</script>