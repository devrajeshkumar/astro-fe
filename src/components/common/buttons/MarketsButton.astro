---
import style from "./MarketsButton.module.scss";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import Typography from "../widgets/typography/Typography.astro";
import Link from "../link/Link.astro";
import { getDomain } from "@utils/common";
import LazyImage from "../lazyImage/LazyImage.astro";
const { changeStyle = "", inLineStyle = {}, id } = Astro.props;
---

<Link
  className={`${style["default"]} ${style["chrome"]} ${style[changeStyle]}`}
  inLineStyle={inLineStyle}
  link={`${getDomain()}/market-overview`}
  id={id}
>
  <LazyImage
    datasrc="/assets/images/google-cta.gif"
    alt="Google CTA"
    inLineStyle={{}}
  />
</Link>
