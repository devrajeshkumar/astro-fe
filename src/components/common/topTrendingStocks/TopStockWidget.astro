---
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import MutualFundsList from "../mutualFundList/MutualFundsList.astro";
import ToolsAndCalculator from "../toolsAndCalculator/ToolsAndCalculator.astro";
import TopTrendingStock from "./TopTrendingStock.astro";
import MutualFundList from "@components/reactComponents/MutualFundList.jsx";
const response = await fetch(
  "https://apihindi.etnownews.com/api/get-trending-stocks-top-mutual-fund?&yearReturn=3YEARRET&perPage=5&pageNo=1"
);
const stockData = await response.json();
---

<ContainerBox>
  <TopTrendingStock trendingStocks={stockData?.data?.trendingStocks?.data} inLineStyle={{marginBottom: '20px'}} />
  <MutualFundList
    inLineStyle={{marginBottom: '20px'}}
    mFCategoriesLandingData={stockData?.data?.mutualFundRankings?.data}
    client:load
  />
  <!-- <MutualFundsList
    mFCategoriesLandingData={stockData?.data?.mutualFundRankings?.data}
  /> -->

  <ToolsAndCalculator inLineStyle={{marginBottom: '20px'}} />
</ContainerBox>
