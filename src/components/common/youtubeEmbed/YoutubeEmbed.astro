---
import style from "./YoutubeEmbed.module.scss";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
const { html_tag_attributes, type } = Astro.props;
if (!html_tag_attributes) return null;
---

{
  type === "WITH_THUMB" ? (
    <div class={`${style["article-paragraph-video"]} ${style["mb-5"]}`}>
      <iframe
        src={`https://www.youtube.com/embed/${html_tag_attributes?.id}`}
        title={`${html_tag_attributes?.title}`}
        frameborder="0"
        allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
        allowfullscreen
      />
    </div>
  ) : (
    <div class={style["container"]}>
      <div class={`${style["youtube_cover"]} ${style["d-flex"]}`}>
        <div class={style["youtubeicon"]}>
          <SvgIcon IconName="YoutubeIcon" />
        </div>
        <a
          href={`https://www.youtube.com/embed/${html_tag_attributes?.id}`}
          target="_black"
        >
          {html_tag_attributes?.title}
        </a>
      </div>
    </div>
  )
}
