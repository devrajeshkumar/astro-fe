---
import style from "./BreadCrumb.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import { generateDataListFromPath } from "../../../utils/common";
import Link from "../link/Link.astro";
import BreadcrumbSchema from "../seo/schema/BreadcrumbSchema.astro";
const { isWrap, inLineStyle, isWhiteLayout = true, category } = Astro.props;
const dataList = generateDataListFromPath(category);
---
<BreadcrumbSchema data={dataList}/>
<ContainerBox isWrap={isWrap} inLineStyle={inLineStyle}>
  <ul
    class={`${style["breadcrumb-list"]} ${isWhiteLayout ? style["white"] : style["black"]}`}
  >
    {
      dataList &&
        dataList.map((item, index) => {
          return (
            <li class={style["listing"]}>
              <Link link={`${item?.seopath}`}>
                <Typography
                  tag={"span"}
                  text={item?.label}
                  changeStyle={"font-size-14"}
                  fontWeight={"400"}
                  isLineClamp={false}
                  isWhiteLayout={false}
                  inLineStyle={{
                    WebkitLineClamp: "1",
                  }}
                />
              </Link>
            </li>
          );
        })
    }
  </ul>
</ContainerBox>
