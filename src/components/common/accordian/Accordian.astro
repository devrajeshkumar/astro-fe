---
import style from "@components/common/accordian/Accordian.module.scss";
import Typography from "../widgets/typography/Typography.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";

export interface Props {
  instanceId?: string;
  title?: string;
  closePrev?: boolean;
  showChildren?: boolean;
  changeStyle?: string;
  inLineStyle?: Record<string, string>;
  headerInLineStyle?: Record<string, string>;
  contentInLineStyle?: Record<string, string>;
  isDarkLayout?: boolean;
  isToggleButton?: boolean;
  togglePosition?: "left" | "right";
  animationDuration?: number;
  defaultOpen?: boolean;
}

const {
  instanceId = "default",
  title = "",
  closePrev = false,
  showChildren = true,
  changeStyle = "",
  inLineStyle = {},
  headerInLineStyle = {},
  contentInLineStyle = {},
  isDarkLayout = false,
  isToggleButton = true,
  togglePosition = "right",
  animationDuration = 300,
  defaultOpen = false,
} = Astro.props;

// Unique IDs
const accordionId = `accordion_${instanceId}`;
const triggerId = `accordionTrigger_${instanceId}`;
const contentId = `accordionContent_${instanceId}`;
---

<div
  id={accordionId}
  class={`${style.accordion} ${changeStyle ? style[changeStyle] : ""} ${defaultOpen ? style.open : ""}`}
  data-accordion
  data-instance={instanceId}
  style={inLineStyle}
>
  <div
    id={triggerId}
    class={style["accordion-header"]}
    data-accordion-trigger
    style={headerInLineStyle}
  >
    <slot name="header">
      {title && <Typography variant="h3">{title}</Typography>}
    </slot>
    {
      showChildren && isToggleButton ? (
        <button
          class={`${style["accordion-toggle"]} ${style[`toggle-${togglePosition}`]}`}
          aria-label="Toggle accordion"
          aria-expanded={defaultOpen}
          aria-controls={contentId}
        >
          <SvgIcon IconName={"rightArrowIconGrey"} width="6" height="10" />
        </button>
      ) : null
    }
  </div>
  {
    showChildren ? (
      <div
        id={contentId}
        class={style["accordion-content"]}
        data-accordion-content
        style={contentInLineStyle}
        role="region"
        aria-labelledby={triggerId}
      >
        <div class={style["accordion-body"]}>
          <slot name="body">
            <slot />
          </slot>
        </div>
      </div>
    ) : null
  }
</div>

<script
  define:vars={{
    instanceId,
    closePrev,
    animationDuration,
    defaultOpen,
    style,
  }}
>
  (function () {
    function initAccordion() {
      if (window.AccordionManager) {
        window.AccordionManager.init(instanceId, {
          closePrev,
          animationDuration,
          defaultOpen,
          cssModules: style, // Pass the CSS module styles
        });
      } else {
        setTimeout(initAccordion, 50);
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initAccordion);
    } else {
      initAccordion();
    }
  })();
</script>
