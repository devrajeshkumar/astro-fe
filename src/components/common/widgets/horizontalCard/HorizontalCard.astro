---
import ImageWithIcon from '@components/common/widgets/imageWithIcon/ImageWithIcon.astro';
import Typography from '@components/common/widgets/typography/Typography.astro';
import CategoryName from '@components/common/widgets/categoryName/CategoryName.astro';
import Link from '@components/common/link/Link.astro';

import styles from './HorizontalCard.module.scss';

const {
  data,
  imageConfig,
  paraConfig,
  titleConfig,
  getUrlConfig,
  categoryNameConfig,
  changeStyle = '',
  inLineStyle = {},
  isRowReverse = false,
  isWhiteLayout = false,
  userLiveUpdateConfig = {},
  isIndividualLinks = false,
  isImage = true,
  isCategory = true,
  videoPlayIconCenter = false,
} = Astro.props;

const defaultLiveUpdateConfig = {
  isBlinker: true,
  isbBlinkerSmall: 'blinker-small',
  inLineStyleBlinker: {
    float: 'right',
    marginTop: '6px',
    marginLeft: '6px',
  },
  isBlinkerAnimation: true,
  isTextVisible: false,
  transparentBtn: false,
};

const liveUpdateConfig = { ...defaultLiveUpdateConfig, ...userLiveUpdateConfig };
const ICON_STORY_LENGTH = 64;
---

{isIndividualLinks ? (
  <figure
    class={`${styles.figure} ${changeStyle ? styles[changeStyle] : ''} ${isRowReverse ? styles['row-reverse'] : ''}`}
    style={inLineStyle}
  >
    <figcaption class={styles.figcaption}>
      {categoryNameConfig?.categoryName && isCategory && (
        <CategoryName
          categoryName={categoryNameConfig.categoryName}
          inLineStyle={{
            color: isWhiteLayout ? '#D7D7D7' : '#b62025',
            lineHeight: '20px',
          }}
          redirectToUrl={categoryNameConfig.redirectUrl}
          title={categoryNameConfig.categoryName}
        />
      )}

      <Link
        link={getUrlConfig?.to}
        title={getUrlConfig?.title}
        className={styles['link-wrap']}
      >
        {titleConfig?.text?.length > 0 && (
          <Typography
            data={data}
            tag={titleConfig.tag}
            text={titleConfig.textLimit ? titleConfig.text.slice(0, ICON_STORY_LENGTH) : titleConfig.text}
            changeStyle={titleConfig.style}
            fontWeight={titleConfig.fontWeight}
            isSecondFontFamily={titleConfig.isSecondFontFamily}
            inLineStyle={titleConfig.inLineStyle}
            isHorizontalCard={true}
            isWhiteLayout={isWhiteLayout}
            cmsType={data?.cmstype || ''}
            isBlinker={liveUpdateConfig.isBlinker}
            isBlinkerText={liveUpdateConfig.isBlinkerText}
            isbBlinkerSmall={liveUpdateConfig.isbBlinkerSmall}
            isBlinkerAnimation={liveUpdateConfig.isBlinkerAnimation}
            isTextVisible={liveUpdateConfig.isTextVisible}
            transparentBtn={liveUpdateConfig.transparentBtn}
            inLineStyleBlinker={{ ...liveUpdateConfig.inLineStyleBlinker }}
            textLimit={titleConfig.textLimit}
            isPremium={titleConfig.text.length > 0 && paraConfig.text.length > 0}
          />
        )}

        {paraConfig?.text?.length > 0 && (
          <Typography
            data={data}
            tag={paraConfig.tag}
            text={paraConfig.textLimit ? paraConfig.text.slice(0, ICON_STORY_LENGTH) : paraConfig.text}
            changeStyle={paraConfig.style}
            fontWeight={paraConfig.fontWeight}
            isSecondFontFamily={paraConfig.isSecondFontFamily}
            inLineStyle={paraConfig.inLineStyle}
            isHorizontalCard={true}
            isWhiteLayout={isWhiteLayout}
            cmsType={data?.cmstype || ''}
            isBlinker={liveUpdateConfig.isBlinker}
            isBlinkerText={liveUpdateConfig.isBlinkerText}
            isbBlinkerSmall={liveUpdateConfig.isbBlinkerSmall}
            isBlinkerAnimation={liveUpdateConfig.isBlinkerAnimation}
            isTextVisible={liveUpdateConfig.isTextVisible}
            transparentBtn={liveUpdateConfig.transparentBtn}
            inLineStyleBlinker={{ ...liveUpdateConfig.inLineStyleBlinker }}
            textLimit={paraConfig.textLimit}
            isPremium={!(titleConfig.text.length > 0 && paraConfig.text.length > 0)}
          />
        )}
      </Link>
    </figcaption>

    {isImage && (
      <Link
        link={getUrlConfig?.to}
        title={getUrlConfig?.title}
        className={styles['link-para-wrap']}
      >
        <ImageWithIcon
          data={data}
          time={imageConfig.time}
          imgWidth={imageConfig.imgWidth}
          imgHeight={imageConfig.imgHeight}
          imagePath={imageConfig.imagePath}
          changeStyle={imageConfig.style}
          inLineStyle={imageConfig.inLineStyle}
          mediaIconStyle={imageConfig.iconStyle}
          inLineMediaIconStyle={imageConfig.inLineIconStyle}
          videoPlayIconCenter={videoPlayIconCenter}
        />
      </Link>
    )}
  </figure>
) : (
  <Link
    link={getUrlConfig?.to}
    title={getUrlConfig?.title}
    className={styles['link-wrap']}
  >
    <figure
      class={`${styles.figure} ${changeStyle ? styles[changeStyle] : ''} ${isRowReverse ? styles['row-reverse'] : ''}`}
      style={inLineStyle}
    >
      <figcaption class={styles.figcaption}>
        <Typography
          tag={titleConfig?.tag}
          text={titleConfig?.text}
          changeStyle={titleConfig?.style}
          fontWeight={titleConfig?.fontWeight}
          isSecondFontFamily={titleConfig?.isSecondFontFamily}
          inLineStyle={titleConfig?.inLineStyle}
          isHorizontalCard={true}
          isWhiteLayout={isWhiteLayout}
          cmsType={data?.cmstype || ''}
          isBlinker={liveUpdateConfig.isBlinker}
          isBlinkerText={liveUpdateConfig.isBlinkerText}
          isbBlinkerSmall={liveUpdateConfig.isbBlinkerSmall}
          isBlinkerAnimation={liveUpdateConfig.isBlinkerAnimation}
          isTextVisible={liveUpdateConfig.isTextVisible}
          transparentBtn={liveUpdateConfig.transparentBtn}
          inLineStyleBlinker={{ ...liveUpdateConfig.inLineStyleBlinker }}
          isPremium={titleConfig?.text?.length > 0 && paraConfig?.text?.length > 0}
        />
        <Typography
          tag={paraConfig?.tag}
          text={paraConfig?.text}
          changeStyle={paraConfig?.style}
          fontWeight={paraConfig?.fontWeight}
          isSecondFontFamily={paraConfig?.isSecondFontFamily}
          inLineStyle={paraConfig?.inLineStyle}
          isHorizontalCard={true}
          isWhiteLayout={isWhiteLayout}
          cmsType={data?.cmstype || ''}
          isBlinker={liveUpdateConfig.isBlinker}
          isBlinkerText={liveUpdateConfig.isBlinkerText}
          isbBlinkerSmall={liveUpdateConfig.isbBlinkerSmall}
          isBlinkerAnimation={liveUpdateConfig.isBlinkerAnimation}
          isTextVisible={liveUpdateConfig.isTextVisible}
          transparentBtn={liveUpdateConfig.transparentBtn}
          inLineStyleBlinker={{ ...liveUpdateConfig.inLineStyleBlinker }}
          isPremium={!(titleConfig?.text?.length > 0 && paraConfig?.text?.length > 0)}
        />
      </figcaption>
      {isImage && (
        <ImageWithIcon
          data={data}
          time={imageConfig.time}
          imgWidth={imageConfig.imgWidth}
          imgHeight={imageConfig.imgHeight}
          imagePath={imageConfig.imagePath}
          changeStyle={imageConfig.style}
          inLineStyle={imageConfig.inLineStyle}
          mediaIconStyle={imageConfig.iconStyle}
          inLineMediaIconStyle={imageConfig.inLineIconStyle}
          videoPlayIconCenter={videoPlayIconCenter}
        />
      )}
    </figure>
  </Link>
)}