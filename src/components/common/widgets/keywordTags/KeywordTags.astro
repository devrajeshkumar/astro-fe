---
import Link from "@components/common/link/Link.astro";
import style from "./KeywordTags.module.scss";
import CustomSlideBox from "@components/common/wrappers/customSlideBox/CustomSlideBox.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
const { data, isArticleShow = false } = Astro.props;

if (!data?.keywords) {
  return "";
}
let keytags = data?.keywords.filter((item) => item.type && item.type);
const checkSpecialCharacter = (value) => {
  const format = /[!@#$%^&*()_+\-=\[\]{};':"\\|,.<>\/?]+/;
  if (format.test(value)) {
    return true;
  } else {
    return false;
  }
};
---

{
  keytags && (
    <ContainerBox inLineStyle={{ marginBottom: "20px" }}>
      <div class={`${style["keyBox"]}`}>
        {keytags &&
          keytags.length > 0 &&
          keytags.slice(0, 5).map((items) => {
            return !checkSpecialCharacter(items?.name) && items?.keywordseo ? (
              <Link
                className={style["keytag"]}
                link={`${import.meta.env.WEBAPP_BASE_URL}/topic/${items.keywordseo.toLowerCase()}`}
              >
                <Typography
                  tag="p"
                  text={items?.name}
                  changeStyle={"font-size-13"}
                  isLineClamp={false}
                  isWhiteLayout={false}
                  inLineStyle={{
                    fontWeight: "400",
                    lineHeight: "inherit",
                    color: "inherit",
                  }}
                />
              </Link>
            ) : null;
          })}
      </div>
    </ContainerBox>
  )
}
