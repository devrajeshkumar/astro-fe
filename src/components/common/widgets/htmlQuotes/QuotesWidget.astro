---
import style from "./QuotesWidget.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import Typography from "../typography/Typography.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
const { data, premium = false } = Astro.props;
const auname = data?.["auname"] ? `- ${data["auname"]}` : "";
if (!data) return null;
---

<ContainerBox>
  <div
    class={`${style["quote-section"]} ${premium && style["premiumQuote"]}`}
  >
    <div class={`${style["quote-icon"]} ${style["lt-tp"]}`}>
      <SvgIcon IconName="quoteIcon" />
    </div>
    <Typography
      tag="blockquote"
      text={data["text"] || data["title"]}
      changeStyle="font-size-16"
      isLineClamp={false}
      inLineStyle={{
        lineHeight: "1.6",
        fontWeight: "normal",
        fontStyle: "italic",
      }}
    />
    <Typography
      tag="p"
      text={auname}
      changeStyle="font-size-14"
      isLineClamp={false}
      inLineStyle={{
        marginTop: "10px",
        fontWeight: "normal",
        color: "rgba(82, 82, 82, 1)",
      }}
    />
    <div class={`${style["quote-icon"]} ${style["rt-bt"]}`}>
      <SvgIcon IconName="quoteIcon" />
    </div>
  </div>
</ContainerBox>
