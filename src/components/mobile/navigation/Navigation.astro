---
import style from "./Navigation.module.scss";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import CustomSlideBox from "@components/common/wrappers/customSlideBox/CustomSlideBox.astro";
import Link from "@components/common/link/Link.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
import { getDomain } from "@utils/common";
const { navLinks = [] } = Astro.props;
const values = Astro.url.searchParams;
const category = values.get("category");
---

<nav class={`${style["nav"]}`} id="navbar-header">
  <ContainerBox>
    <CustomSlideBox
      elementType="ulBox"
      gridGap={16}
      changeStyle=""
      marginTop={0}
      marginBottom={0}
      inLineStyle={{ paddingTop: "4px", paddingBottom: "4px" }}
    >
      <li>
        <Link
          link={"https://www.timesnownews.com/initiatives/smart-nivesh-sahi-nivesh"}
          target="_blank"
          className={`${style["nav-link"]} ${style["nav-mutual-fund"]}`}
        >
          <img
            src="https://static.tnn.in/photo/msid-118213542/118213542.jpg"
            alt="Mutual Fund Sahi Hai"
          />
        </Link>
      </li>
      {
        navLinks?.slice(0, 10)?.map((item) => (
          <li>
            <Link
              link={`${getDomain()}/${item.seopath}`}
              className={`${style["nav-link"]} ${item?.seopath === category ? style["nav-active"] : ""}`}
            >
              <Typography
                tag="span"
                text={item.title}
                changeStyle="font-size-14"
                fontWeight="400"
                isLineClamp={false}
                isWhiteLayout={false}
                inLineStyle={{ WebkitLineClamp: "1" }}
              />
            </Link>
          </li>
        ))
      }
    </CustomSlideBox>
  </ContainerBox>
</nav>
<script>
  const hamburgerButton = document.getElementById("hamburger-button");
  const closeHamburgerButton = document.getElementById(
    "mobileHamburgerCloseIcon"
  );
  const handleScroll = () => {
    const div = document.getElementById("navbar-header");
    if (div) {
      const rect = div.getBoundingClientRect();
      const isAtTop = rect.top <= 3;
      if (isAtTop) {
        hamburgerButton.style.display = "block";
      } else hamburgerButton.style.display = "none";
    }
  };

  if (hamburgerButton) {
    hamburgerButton.addEventListener("click", function () {
      document.getElementById("mobileHamburgerPopup").style.left = "0";
      document.body.style.overflow = "hidden";
    });
  }
  if (closeHamburgerButton) {
    closeHamburgerButton.addEventListener("click", function () {
      document.getElementById("mobileHamburgerPopup").style.left = "-100%";
      document.body.style.overflow = "";
    });
  }
  document.addEventListener("scroll", handleScroll);
</script>
