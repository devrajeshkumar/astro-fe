---
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import style from "./TextLinkComponent.module.scss";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
const { htmlText, iconType } = Astro.props;
if (!iconType) return null;
---

<ContainerBox>
  <div class={`${style["youtube_cover"]} ${style["d-flex"]}`}>
    {
      iconType == "media-video" && (
        <div class={style["youtubeicon"]}>
          <SvgIcon IconName="YoutubeIcon" />
        </div>
      )
    }
    <div class={style["article-paragraph"]} set:html={htmlText} />
  </div>
</ContainerBox>
