---
import style from "./TitleComponent.module.scss";
import dayjs from "dayjs";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import Typography from "@components/common/widgets/typography/Typography.astro";
const { index, mainData, updatedate } = Astro.props;
---

<ContainerBox>
  {
    index == 0 ? (
      <Typography
        tag="h1"
        text={mainData.title}
        changeStyle={"font-size-26"}
        isLineClamp={false}
        isWhiteLayout={false}
        inLineStyle={{
          fontWeight: "900",
          lineHeight: "1.385",
          marginBottom: "12px",
        }}
      />
    ) : (
      <Typography
        tag="h4"
        text={mainData.title}
        changeStyle={"font-size-18"}
        fontWeight={"700"}
        isLineClamp={false}
        isWhiteLayout={false}
        inLineStyle={{
          lineHeight: "1.5",
          marginBottom: "13px",
        }}
      />
    )
  }
</ContainerBox>
