---
import TitleComponent from "./TitleComponent.astro";
import ContainerBox from "@components/common/wrappers/containerBox/ContainerBox.astro";
import CategoryName from "@components/common/widgets/categoryName/CategoryName.astro";
import AuthorDetailMobile from "@components/common/authorDetail/AuthorDetailMobile.astro";
import Synopsis from "./Synopsis.astro";
import KeyHighlight from "./KeyHighlight.astro";
import AdCaller from "@components/common/adcaller/AdCaller.astro";
import CoverVDOAndImg from "./CoverVDOAndImg.astro";
import MgIdComponent from "@components/common/mgid/MgIdComponent.astro";
import CONST from "src/constant";
import OneLiner from "@components/common/oneLiner/OneLiner.astro";
import KeywordTags from "@components/common/widgets/keywordTags/KeywordTags.astro";
import BreadCrumb from "@components/common/breadCrumb/BreadCrumb.astro";
import LatestNews from "@components/common/latestNews/LatestNews.astro";
import RelatedNews from "@components/common/relatedNews/RelatedNews.astro";
import { getDomain, getUrl } from "@utils/common";
import AdContainer from "@components/common/adcontainer/AdContainer.astro";
import ScrollHideButtons from "@components/common/buttons/ScrollHideButtons.astro";
import ShareIcon from "../socialShare/ShareIcon.astro";
import { processReadingTime } from "@utils/common";
import SubscribeWithEmail from "@components/common/subscribeWithEmail/SubscribeWithEmail.astro";
import WebPageSchema from "@components/common/seo/schema/WebPageSchema.astro";
import NewsArticleSchema from "@components/common/seo/schema/NewsArticleSchema.astro";
import style from "./Article.module.scss";
import RenderEmbeds from "./RenderEmbeds.astro"

const { category, msid, app } = Astro.props;
const mainData = app?.response?.sections?.article_show?.data?.[0];
const ads = app?.response?.ads;
---

<WebPageSchema data={mainData} pathname={getUrl(mainData)} />
<NewsArticleSchema data={mainData} pathname={getUrl(mainData)} />
<ContainerBox inLineStyle={{ marginBottom: "7px" }}>
  <CategoryName
    categoryName={category?.split("-").join(" ") ||
      mainData?.categoryname ||
      ""}
    changeStyle={"font-size-12"}
    inLineStyle={{
      fontWeight: "600",
      color: "#696969",
      lineHeight: "1.2",
      textDecoration: "underline",
    }}
    redirectToUrl={`${getDomain()}/${category}`}
    title={category || mainData?.categoryname || ""}
  />
</ContainerBox>
<TitleComponent index={0} mainData={mainData} />

{
  mainData && (mainData.authors || mainData.updatedate || mainData.agency) ? (
    <ContainerBox inLineStyle={{ marginBottom: "15px" }}>
      <AuthorDetailMobile
        byline={mainData?.Byline}
        updatedate={`${mainData?.updatedate}`}
        inLineStyle={{}}
      />
    </ContainerBox>
  ) : null
}

<ScrollHideButtons
  nextStory={app?.response?.nextStory}
  prevStroy={app?.response?.prevStory}
/>
<Synopsis text={mainData.synopsis} inLineStyle={{ marginBottom: "34px" }} />
<ShareIcon
  type={"TOP_SHARE_ICONS"}
  time={processReadingTime(mainData)}
  mainData={mainData}
/>
<AdContainer
  inLineStyle={{ width: "300px", minHeight: "250px", marginBottom: "16px" }}
>
  <AdCaller {...app?.response?.ads?.atf} atf={true} />
</AdContainer>
{
  mainData?.summary ? (
    <Fragment>
      <KeyHighlight summary={mainData.summary} />
      <CoverVDOAndImg
        data={mainData?.cmsassoc || []}
        isMediaWireStory={mainData?.isMediaWireStory}
        mainData={mainData}
      />
    </Fragment>
  ) : null
}
 
  {mainData?.embedData?.map((embedData, dataIndex) => (
  <RenderEmbeds
    embedData={embedData}
    dataIndex={dataIndex}
    mainData={mainData}
    app={app}
    msid={msid}
  />
))}

<div class={`collapsed ${style["collapsed"]}`}>
  <AdContainer
    inLineStyle={{
      width: "300px",
      minHeight: "250px",
      margin: "16px auto",
    }}
  >
    <AdCaller {...ads?.btf1} />
  </AdContainer>
  <KeywordTags data={mainData} />
  <OneLiner />
  <BreadCrumb isWrap={true} category="news" />
  <RelatedNews data={mainData?.editorpicks} />
  <ShareIcon
    mainData={mainData}
    type={"BOTTOM_SHARE_ICONS"}
    followus="ET_HINDI"
  />
  <SubscribeWithEmail />
</div>
<MgIdComponent
  scriptID={CONST.MGID_ADD_5X5}
  elementID={CONST.MGID_ADD_5X5}
  lazy={true}
/>
<LatestNews data={mainData?.latestSiblings} />

<script define:vars={{ style }}>
  const handleReadMoreClick = () => {
    const readMoreButton = document.getElementById("read-more-btn");
    const readMoreDiv = document.getElementById("mgid-read-more");
    readMoreButton?.addEventListener("click", () => {
      const paras = document.querySelectorAll(`.${style["collapsed"]}`);
      const clipedPara = document.querySelector(`.${style["clipped-para"]}`);
      clipedPara.classList.remove(style["clipped-para"])
      paras?.forEach((element) => element.classList.remove(style["collapsed"]));
      readMoreDiv.style.display = "none";
      readMoreDiv.style.height = "0px";
    });
  };
  handleReadMoreClick();
</script>
