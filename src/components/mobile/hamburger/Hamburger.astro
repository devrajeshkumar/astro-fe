---
import Typography from "@components/common/widgets/typography/Typography.astro";
import Link from "@components/common/link/Link.astro";
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import style from "./Hamburger.module.scss";
import Search from "@components/common/search/Search.astro";
import { getDomain, getUrl, NAVIGATION_GROUPS } from "@utils/common";
import Accordian from "@components/common/accordian/Accordian.astro";
const {
  hamburgerOpenId = "",
  hamburgerCloseId = "",
  inLineStyle = {},
  data,
} = Astro.props;
const values = Astro.url.searchParams;

function groupMenuData(flatData) {
  const findByTitle = (title) =>
    flatData?.find((item) => item?.title === title);

  return NAVIGATION_GROUPS?.map((group) => ({
    section: group?.section,
    icon: group?.icon,
    items: group?.titles
      ?.map((title) => findByTitle(title))
      ?.filter(Boolean) // Remove undefined if title not found
      ?.map((item) => {
        if (item?.child) {
          return {
            ...item,
            child: item?.child?.map((child) => ({ ...child })),
          };
        }
        return item;
      }),
  }));
}

const groupedDataNavigation = groupMenuData(data);
---

<div class={style["box"]} id={hamburgerOpenId} style={{ ...inLineStyle }}>
  <div class={style["box-header"]}>
    <div class={style["box-top"]}>
      <button id={hamburgerCloseId}>
        <SvgIcon IconName={"CloseIconBig"} width={26} height={16} />
      </button>
      <Link link={""} className={style["live-tv"]}>
        <SvgIcon
          IconName={"livetvNewIcon"}
          width={26}
          height={16}
          inLineStyle={{ marginTop: "-2px" }}
        />
        <Typography
          tag={"span"}
          text={"Live TV"}
          changeStyle={"font-size-12"}
          fontWeight={"400"}
          isLineClamp={false}
          isWhiteLayout={true}
          inLineStyle={{
            WebkitLineClamp: "1",
            lineHeight: "20px",
            textTransform: "uppercase",
          }}
        />
      </Link>
    </div>
    <Search
      instanceId="hamburger"
      changeStyle="mobile-search"
      inLineStyle={{
        padding: "0px 15px 10px 15px",
        boxShadow: "none",
        borderBottom: "1px solid #d4d4d4",
      }}
    />
  </div>

  <div class={style["box-body"]}>
    <nav class={style.navigation} id="hamburgerMenu">
      <ul class={style.mainMenu}>
        <li class={style.categoryHome}>
          <Link
            link={"/"}
            className={`${style.categoryHeader} ${style["active"]}`}
          >
            <SvgIcon IconName={"HomeIcon"} width="21" height="20" />
            <h3 class={style.categoryTitle}>होम</h3>
          </Link>
        </li>
        <!-- <li class={style.categoryPremium}>
          <Link link={"/"} className={style.categoryHeader}>
            <img src="/assets/images/Premiumhead.svg" alt="Premium" />
          </Link>
        </li> -->
        {
          groupedDataNavigation?.map((category) => (
            <li class={style.categoryItem}>
              <div class={style.categoryHeader}>
                <span class={style.categoryIcon} aria-hidden="true">
                  <SvgIcon IconName={category.icon} width="17" height="17" />
                </span>
                <Typography
                  tag={"h3"}
                  text={category.section}
                  changeStyle={"font-size-16"}
                  fontWeight={"600"}
                  isLineClamp={false}
                  isWhiteLayout={false}
                  inLineStyle={{
                    WebkitLineClamp: "1",
                    lineHeight: "44px",
                    color: "inherit",
                  }}
                />
              </div>
              <ul class={style.subMenu}>
                {category.items.map((item) => (
                  <Accordian showChildren={item?.children?.length > 0} title={item?.title} instanceId={item?.title} closePrev={true}>
                    <Link
                      slot="header"
                      link={`${getDomain()}/${item?.seopath}`}
                      className={`${style.categoryHeader} ${
                        item?.seopath?.split("/").pop() ===
                        values.get("category")
                          ? style["active"]
                          : ""
                      }`}
                    >
                      <Typography
                        tag={"p"}
                        text={item?.title}
                        changeStyle={"font-size-16"}
                        fontWeight={"500"}
                        isLineClamp={false}
                        isWhiteLayout={false}
                        inLineStyle={{
                          WebkitLineClamp: "1",
                          lineHeight: "44px",
                          color: "inherit",
                        }}
                      />
                    </Link>
                    <ul class={style.subMenu} slot="body">
                      {item?.child?.map((item) => (
                        <li class={style.categoryItem}>
                          <Link
                            link={`${getUrl(item)}`}
                            className={`${style.categoryHeader}`}
                          >
                            <Typography
                              tag={"span"}
                              text={`${item.title}`}
                              changeStyle={"font-size-16"}
                              fontWeight={"500"}
                              isLineClamp={false}
                              isWhiteLayout={false}
                              inLineStyle={{
                                WebkitLineClamp: "1",
                                lineHeight: "44px",
                                color: "inherit",
                              }}
                            />
                          </Link>
                        </li>
                      ))}
                    </ul>
                  </Accordian>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</div>
