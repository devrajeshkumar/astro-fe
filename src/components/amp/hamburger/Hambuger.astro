---
import SvgIcon from "@components/common/svg/SvgIcon.astro";
import { NAVIGATION_GROUPS } from "@utils/common";

const { data } = Astro.props;

function groupMenuData(flatData) {
  const findByTitle = (title) =>
    flatData?.find((item) => item?.title === title);

  return NAVIGATION_GROUPS?.map((group) => ({
    section: group?.section,
    icon: group?.icon,
    items: group?.titles
      ?.map((title) => findByTitle(title))
      ?.filter(Boolean) // Remove undefined if title not found
      ?.map((item) => {
        if (item?.child) {
          return {
            ...item,
            child: item?.child?.map((child) => ({ ...child })),
          };
        }
        return item;
      }),
  }));
}

const groupedDataNavigation = groupMenuData(data);

